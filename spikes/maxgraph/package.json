  "dependencies": {
    "@maxgraph/core": "0.25.2",
    "elkjs": "0.12.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer-core": "25.19.0",
    "typescript": "7.0.2"
  }
}
